# Copy this file to .env to keep your own test settings (.env is not committed).
# A variable set in the shell, e.g. `TEST_BROWSER=chrome npm test`, wins over this file.

# Browser that runs the tests:
#   chromium (default) · chrome · edge · firefox · webkit · dia · brave
#   or the full path to any other Chromium-based browser
#   (dia always runs without a window: Dia doesn't show pages opened by test tools)
TEST_BROWSER=chromium

# Pause between steps in milliseconds while watching (default 400)
# SLOWMO=400

# 1 = no browser window, run in parallel (same as `npm run test:fast`)
# HEADLESS=1
